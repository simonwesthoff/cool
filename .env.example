# Copy to .env and adjust. Never commit .env.

# Domain Caddy serves. "localhost" locally, the real domain on the VPS.
APP_DOMAIN=localhost

# How Caddy sets up HTTPS:
#   local  -> certificate from Caddy's own local CA (browser warns once)
#   public -> Let's Encrypt certificate for APP_DOMAIN, plus HSTS (VPS)
TLS_MODE=local

# PostgreSQL credentials, used by the db container and to build the app's
# connection string. Use URL-safe characters in the password.
POSTGRES_USER=cool
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cool

# Host port for PostgreSQL when using docker-compose.dev.yml (local only).
POSTGRES_HOST_PORT=5432

# Connection string for running the app or scripts outside Docker
# (npm run dev, npm run db:migrate). Inside Docker Compose it is set
# automatically from the values above.
DATABASE_URL=postgres://cool:change-me@localhost:5432/cool

# --- Sign-in (Better Auth + Google) ---

# Secret for signing session data. At least 32 random characters, e.g.
# `openssl rand -base64 32`. Use a different value on every environment.
BETTER_AUTH_SECRET=

# Public URL of the app for `npm run dev`. Inside Docker Compose it is set
# automatically to https://${APP_DOMAIN}.
BETTER_AUTH_URL=https://localhost:3000

# OAuth client from the Google Cloud Console (type "Web application"); see
# README.md. Authorized redirect URIs:
#   https://localhost:3000/api/auth/callback/google  (npm run dev)
#   https://localhost/api/auth/callback/google       (Docker Compose)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
