# TLS_MODE selects how HTTPS is set up (see .env.example):
#   local  -> certificate from Caddy's own local CA (browser warns once), no HSTS
#   public -> automatic Let's Encrypt certificate, HSTS
# Plain HTTP on port 80 only redirects to HTTPS (Caddy default).

(tls_local) {
	tls internal
}

(tls_public) {
	header Strict-Transport-Security "max-age=31536000"
}

{$APP_DOMAIN} {
	import tls_{$TLS_MODE}
	encode zstd gzip
	reverse_proxy app:3000
}
